#include <stdio.h>
#include <string.h>

// Helper function to reverse a local segment of the string in place
void reverseWord(char* s, int start, int end) {
    while (start < end) {
        char temp = s[start];
        s[start] = s[end];
        s[end] = temp;
        start++;
        end--;
    }
}

char* reverseWords(char* s) {
    int len = strlen(s);
    int word_start = 0;

    for (int i = 0; i <= len; i++) {
        // Trigger reversal when we hit a space or the end of the string
        if (s[i] == ' ' || s[i] == '\0') {
            // The word ends at index i - 1
            reverseWord(s, word_start, i - 1);
            
            // Set the start index for the next word
            word_start = i + 1;
        }
    }

    return s;
}
