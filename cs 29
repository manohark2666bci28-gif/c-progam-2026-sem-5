#include <stdio.h>
#include <string.h>

// Helper function to reverse a specific segment of the string in place
void reverseSegment(char* s, int start, int end) {
    while (start < end) {
        char temp = s[start];
        s[start] = s[end];
        s[end] = temp;
        start++;
        end--;
    }
}

char* reverseStr(char* s, int k) {
    int len = strlen(s);
    
    // Jump by 2k characters in each iteration
    for (int i = 0; i < len; i += 2 * k) {
        // Find the end index for reversal
        // If remaining characters are less than k, reverse up to the end of string
        int end = (i + k - 1 < len - 1) ? (i + k - 1) : (len - 1);
        
        reverseSegment(s, i, end);
    }
    
    return s;
}
