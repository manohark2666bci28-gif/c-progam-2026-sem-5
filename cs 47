int minimumRecolors(char* blocks, int k) {
    int left = 0, right = 0, numWhites = 0;
    while(right < k) {
        if(blocks[right++] == 'W') numWhites++;
    }

    int numRecolors = numWhites, n = strlen(blocks);
    while(right < n) {
        if(blocks[left++] == 'W') numWhites--;
        if(blocks[right++] == 'W') numWhites++;
        numRecolors = fmin(numRecolors, numWhites);
    }

    return numRecolors;
}
