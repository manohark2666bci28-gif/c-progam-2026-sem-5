#include <stdio.h>
#include <string.h>
#include <stdbool.h>

// Helper function to check if a character is a vowel
bool isVowel(char c) {
    return c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u' ||
           c == 'A' || c == 'E' || c == 'I' || c == 'O' || c == 'U';
}

char* reverseVowels(char* s) {
    int left = 0;
    int right = strlen(s) - 1;
    
    while (left < right) {
        // Move left pointer forward if it's not a vowel
        if (!isVowel(s[left])) {
            left++;
            continue;
        }
        
        // Move right pointer backward if it's not a vowel
        if (!isVowel(s[right])) {
            right--;
            continue;
        }
        
        // Both pointers are on vowels -> Swap them
        char temp = s[left];
        s[left] = s[right];
        s[right] = temp;
        
        // Move both pointers inward
        left++;
        right--;
    }
    
    return s;
}
