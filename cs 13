#include <stdio.h>
#include <string.h>
#include <stdbool.h>

bool isIsomorphic(char* s, char* t) {
    int sLen = strlen(s);
    int tLen = strlen(t);
    
    // If lengths are different, they cannot be isomorphic
    if (sLen != tLen) {
        return false;
    }
    
    // Arrays to store the 1-based index of the last seen position for each ASCII character
    int mapS[256] = {0};
    int mapT[256] = {0};
    
    for (int i = 0; i < sLen; i++) {
        unsigned char charS = (unsigned char)s[i];
        unsigned char charT = (unsigned char)t[i];
        
        // If the last seen positions do not match, the mapping is invalid
        if (mapS[charS] != mapT[charT]) {
            return false;
        }
        
        // Update the last seen position to i + 1 (1-based index to avoid conflict with default 0)
        mapS[charS] = i + 1;
        mapT[charT] = i + 1;
    }
    
    return true;
}
