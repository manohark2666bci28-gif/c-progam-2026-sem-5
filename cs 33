#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define MIN(a, b) ((a) < (b) ? (a) : (b))

/**
 * Note: The returned array must be malloced, assume caller calls free().
 */
int* shortestToChar(char* s, char c, int* returnSize) {
    int len = strlen(s);
    *returnSize = len;
    
    // Allocate memory for the answer array
    int* ans = (int*)malloc(len * sizeof(int));
    
    // c_pos tracks the last seen index of character 'c'
    // Initialize to a value far outside bounds to simulate infinity
    int c_pos = -100000; 
    
    // Pass 1: Left-to-Right Scan
    for (int i = 0; i < len; i++) {
        if (s[i] == c) {
            c_pos = i;
        }
        ans[i] = i - c_pos;
    }
    
    // Pass 2: Right-to-Left Scan
    c_pos = 100000; // Reset to far positive bound
    for (int i = len - 1; i >= 0; i--) {
        if (s[i] == c) {
            c_pos = i;
        }
        // Take the minimum of the distance from the left or right
        ans[i] = MIN(ans[i], c_pos - i);
    }
    
    return ans;
}
