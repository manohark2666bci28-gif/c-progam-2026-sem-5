#include <stdio.h>
#include <string.h>

// Helper function to map a Roman character to its integer value
int getRomanValue(char c) {
    switch (c) {
        case 'I': return 1;
        case 'V': return 5;
        case 'X': return 10;
        case 'L': return 50;
        case 'C': return 100;
        case 'D': return 500;
        case 'M': return 1000;
        default:  return 0;
    }
}

int romanToInt(char* s) {
    int total = 0;
    int len = strlen(s);
    
    for (int i = 0; i < len; i++) {
        int currentVal = getRomanValue(s[i]);
        
        // If there is a next character, check its value
        if (i + 1 < len) {
            int nextVal = getRomanValue(s[i + 1]);
            
            // Subtractive rule: current value is less than next value
            if (currentVal < nextVal) {
                total -= currentVal;
            } else {
                total += currentVal;
            }
        } else {
            // Last character is always added
            total += currentVal;
        }
    }
    
    return total;
}
