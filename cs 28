#include <stdio.h>
#include <stdlib.h>

// Comparison function needed for qsort
int compare(const void* a, const void* b) {
    long long diff = *(int*)a - *(int*)b;
    if (diff < 0) return -1;
    if (diff > 0) return 1;
    return 0;
}

int findContentChildren(int* g, int gSize, int* s, int sSize) {
    // Step 1: Sort both arrays in ascending order
    qsort(g, gSize, sizeof(int), compare);
    qsort(s, sSize, sizeof(int), compare);
    
    int child_ptr = 0;
    int cookie_ptr = 0;
    
    // Step 2: Iterate through both arrays using two pointers
    while (child_ptr < gSize && cookie_ptr < sSize) {
        // If the cookie is large enough, satisfy the child
        if (s[cookie_ptr] >= g[child_ptr]) {
            child_ptr++; // Move to next child
        }
        // Always consume the cookie (move to the next cookie)
        cookie_ptr++;
    }
    
    // The index of child_ptr represents the total number of content children
    return child_ptr;
}
